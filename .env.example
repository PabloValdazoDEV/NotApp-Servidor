# Base de datos de desarrollo o staging, nunca la de producción
DATABASE_URL=postgresql://user:password@localhost:5432/notapp

# Clave larga y aleatoria
JWT_SECRET=change-me

# Orígenes permitidos separados por comas
VITE_API_URL=http://localhost:5173

# Orígenes internos de las apps Capacitor, separados por comas
CAPACITOR_ORIGINS=https://localhost,capacitor://localhost,http://localhost

# Ruta de registro
URL_REGISTER=/register

# URL pública usada en enlaces de emails
URL=http://localhost:5173/

# Protección contra abuso y picos de tráfico.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL_MAX=1000
RATE_LIMIT_GLOBAL_WINDOW_MINUTES=15
# Pon 1 si el servidor está detrás de un único proxy inverso.
TRUST_PROXY=0

# Código de registro: solo se permiten valores entre 15 y 30 minutos.
REGISTRATION_CODE_EXPIRES_MINUTES=15

# Google Sign-In
# El client ID web también puede ser el client ID del servidor.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_SERVER_CLIENT_ID=
# Se rellenan al preparar las aplicaciones nativas.
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
# Alternativa para varios client IDs separados por comas.
GOOGLE_CLIENT_IDS=

NAME_CLOUDINARY=
API_KEY_CLOUDINARY=
API_SECRET_CLOUDINARY=

SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Opcionales: búsqueda de imágenes
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
BING_IMAGE_SEARCH_API_KEY=
SERPAPI_API_KEY=
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
